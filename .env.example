PORT=3000
NODE_ENV=production
# Chuỗi ngẫu nhiên dài, dùng ký cookie giỏ hàng/đăng nhập
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-dai
# Mật khẩu vào trang /admin
ADMIN_PASSWORD=doi-mat-khau-admin
SITE_URL=https://kinie.vn

# Thông tin chuyển khoản hiển thị ở trang thanh toán (web chỉ nhận chuyển khoản trước 100%)
# BANK_ID: mã ngân hàng theo VietQR (vd VCB, MB, TCB, ACB, VPB) để hiện mã QR chuyển khoản có sẵn số tiền
BANK_ID=VCB
BANK_NAME=Vietcombank
BANK_ACCOUNT=0123456789
BANK_HOLDER=NGUYEN VAN A

# Liên hệ hiển thị trên site
CONTACT_EMAIL=hello@kinie.vn
CONTACT_PHONE=0900 000 000
ZALO_URL=https://zalo.me/0900000000
INSTAGRAM_URL=https://instagram.com/kinie.magnet
FACEBOOK_URL=https://facebook.com/kinie.magnet

# (Tuỳ chọn) Google Sheet đơn hàng + Gmail báo đơn qua Apps Script (xem README, apps-script/don-hang.gs)
ORDERS_HOOK_URL=
ORDERS_HOOK_SECRET=

# (Tuỳ chọn) SMTP để gửi mail khi có đơn / form liên hệ
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
