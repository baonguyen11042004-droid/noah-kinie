<%- include('partials/header') %>
<section class="sec">
  <div class="wrap">
    <h1 class="h2"><%= t('checkoutTitle') %></h1>
    <% if (errors.length) { %><ul class="errors" role="alert"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul><% } %>
    <div class="co">
      <form method="post" action="/thanh-toan" class="form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label><%= t('fName') %><input name="name" value="<%= form.name || '' %>" required autocomplete="name"></label>
        <div class="row2">
          <label><%= t('fPhone') %><input name="phone" type="tel" value="<%= form.phone || '' %>" required autocomplete="tel"></label>
          <label><%= t('fEmail') %><input name="email" type="email" value="<%= form.email || '' %>" autocomplete="email"></label>
        </div>
        <label><%= t('fAddress') %><input name="address" value="<%= form.address || '' %>" required autocomplete="street-address"></label>
        <label><%= t('fNote') %><textarea name="note" rows="3"><%= form.note || '' %></textarea></label>
        <fieldset>
          <legend><%= t('payMethod') %></legend>
          <label class="opt"><input type="radio" name="payment" value="cod" <%= form.payment !== 'bank' ? 'checked' : '' %>> <%= t('payCod') %></label>
          <label class="opt"><input type="radio" name="payment" value="bank" <%= form.payment === 'bank' ? 'checked' : '' %>> <%= t('payBank') %></label>
        </fieldset>
        <button class="btn btn--block"><%= t('placeOrder') %></button>
      </form>
      <aside class="sum">
        <h3><%= t('yourOrder') %></h3>
        <% cart.items.forEach(i => { %><p><span><%= t('comboOf', i.product.qty) %> × <%= i.qty %></span><span><%= money(i.total) %></span></p><% }) %>
        <p><span><%= t('shipShort') %></span><span><%= cart.shipping ? money(cart.shipping) : t('free') %></span></p>
        <p class="sum__t"><span><%= t('total') %></span><span><%= money(cart.total) %></span></p>
      </aside>
    </div>
  </div>
</section>
<%- include('partials/footer') %>