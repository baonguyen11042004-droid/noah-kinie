<%- include('partials/header') %>
<section class="sec">
  <div class="wrap narrow">
    <h1 class="h2"><%= t('cartTitle') %></h1>
    <% if (!cart.items.length) { %>
      <p class="empty"><%= t('cartEmpty') %></p>
      <a class="btn" href="<%= u('/bang-gia') %>"><%= t('shopNow') %></a>
    <% } else { %>
      <ul class="lines">
        <% cart.items.forEach(i => { %>
        <li class="line">
          <img src="<%= productImg(i.product) %>" alt="" width="80" height="80">
          <div class="line__n">
            <a href="<%= u('/san-pham/' + i.product.slug) %>"><%= t('comboOf', i.product.qty) %><%= i.qty > 1 ? ' × ' + i.qty : '' %></a>
            <span><%= money(i.product.price) %></span>
            <span class="line__ph"><%= t('photosLabel') %>:
              <% if (i.photos) { %><a href="<%= i.photos %>" target="_blank" rel="noopener noreferrer nofollow"><%= t('openLink') %> ↗</a>
              <% } else { %><%= t('photosZalo') %><% } %></span>
          </div>
          <form method="post" action="<%= u('/gio-hang/cap-nhat') %>" class="qty">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="i" value="<%= i.index %>"><input type="hidden" name="qty" value="0">
            <button class="btn btn--ghost btn--sm"><%= t('remove') %></button>
          </form>
          <strong><%= money(i.total) %></strong>
        </li>
        <% }) %>
      </ul>
      <div class="sum">
        <p><span><%= t('subtotal') %></span><span><%= money(cart.subtotal) %></span></p>
        <p><span><%= t('shipping') %></span><span><%= cart.shipping ? money(cart.shipping) : t('free') %></span></p>
        <% if (cart.shipping) { %><p class="note"><%= t('freeshipHint', money(site.freeShip - cart.subtotal)) %></p><% } %>
        <p class="sum__t"><span><%= t('totalFull') %></span><span><%= money(cart.total) %></span></p>
        <a class="btn btn--block" href="<%= u('/thanh-toan') %>"><%= t('checkoutGo') %></a>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>