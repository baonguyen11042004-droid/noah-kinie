<%- include('partials/header') %>
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__t">
      <span class="badge-soft"><%= t('handmadeBadge') %></span>
      <h1><%= t('heroTitle1') %><br><em><%= t('heroTitle2') %></em></h1>
      <p class="lead"><%= t('heroBody') %></p>
      <div class="hero__cta">
        <a class="btn" href="/cua-hang"><%- include('partials/icon', { name: 'bag' }) %><%= t('heroCta') %></a>
        <a class="btn btn--zalo" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloCta') %></a>
      </div>
      <ul class="stats-row">
        <% t('stats').forEach(s => { %><li><b><%= s[0] %></b><span><%= s[1] %></span></li><% }) %>
      </ul>
    </div>
    <div class="hero__art">
      <div class="hero__mascot">
        <span class="ribbon"><%= t('ribbon') %></span>
        <img src="/img/mascot.jpg" alt="<%= t('mascotAlt') %>" width="280" height="310">
      </div>
      <div class="hero__mags" aria-hidden="true">
        <img class="ph ph1" src="/art/p6.svg" alt="">
        <img class="ph ph2" src="/art/p20.svg" alt="">
        <img class="ph ph3" src="/art/p50.svg" alt="">
      </div>
    </div>
  </div>
</section>

<section class="sec sec--feat">
  <div class="wrap">
    <div class="feats">
      <% const fi = ['sparkle', 'layers', 'magnet']; t('feat').forEach((f, i) => { %>
      <div class="feat"><span class="feat__i"><%- include('partials/icon', { name: fi[i] }) %></span><div><h3><%= f[0] %></h3><p><%= f[1] %></p></div></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec__head"><div><p class="eyebrow"><%= t('quickEyebrow') %></p><h2><%= t('quickTitle') %></h2><p class="lead"><%= t('quickSub') %></p></div><a class="link" href="/bang-gia"><%= t('viewAll') %></a></div>
    <div class="grid">
      <% quick.forEach((p, i) => { %><%- include('partials/card', { p, sub: t('cardSubs')[i] }) %><% }) %>
      <div class="card card--dash">
        <h3><%= t('otherQtyTitle') %></h3>
        <p><%= t('otherQtyBody') %></p>
        <a class="btn btn--ghost" href="/bang-gia"><%= t('openPrice') %></a>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--tint">
  <div class="wrap">
    <p class="eyebrow center"><%= t('stepsEyebrow') %></p>
    <h2 class="center"><%= t('stepsTitle') %></h2>
    <ol class="steps">
      <% t('steps').forEach((s, i) => { %><li><b><%= i + 1 %></b><h3><%= s[0] %></h3><p><%= s[1] %></p></li><% }) %>
    </ol>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <p class="eyebrow center"><%= t('quotesEyebrow') %></p>
    <h2 class="center"><%= t('quotesTitle') %></h2>
    <div class="quotes">
      <% t('quotes').forEach(q => { %><blockquote>“<%= q[0] %>”<cite>— <%= q[1] %></cite></blockquote><% }) %>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap cta">
    <div><h2><%= t('ctaTitle') %></h2><p><%= t('ctaBody') %></p></div>
    <a class="btn btn--zalo" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloCta') %></a>
  </div>
</section>
<%- include('partials/footer') %>