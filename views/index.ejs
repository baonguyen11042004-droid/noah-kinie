<%- include('partials/header') %>
<section class="hero">
  <div class="wrap hero__in">
    <div class="hero__t">
      <span class="badge-soft"><%= t('handmadeBadge') %></span>
      <h1><span class="h1-kw"><%= t('heroKw') %></span><%= t('heroTitle1') %><br><em><%= t('heroTitle2') %></em></h1>
      <p class="lead"><%= t('heroBody') %></p>
      <div class="hero__cta">
        <a class="btn" href="<%= u('/cua-hang') %>"><%- include('partials/icon', { name: 'bag' }) %><%= t('heroCta') %></a>
        <a class="btn btn--zalo" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloCta') %></a>
      </div>
      <ul class="stats-row">
        <% t('stats').forEach(s => { %><li><b><%= s[0] %></b><span><%= s[1] %></span></li><% }) %>
      </ul>
    </div>
    <div class="hero__art">
      <div class="hero__top">
        <span class="ribbon"><%= t('ribbon') %></span>
        <img class="hero__mascot" src="/img/mascot.jpg" alt="<%= t('mascotAlt') %>" width="150" height="166">
      </div>
      <div class="hero__cards">
        <% [['l', 'mau-em-be'], ['m', 'mau-cap-doi'], ['r', 'mau-gia-dinh']].forEach(([pos, img], i) => { %><div class="mag mag--<%= pos %>"><img src="/img/sp/<%= img %>.webp" alt="<%= t('heroAlts')[i] %>" width="440" height="640"></div><% }) %>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--feat">
  <div class="wrap">
    <div class="feats">
      <% const fi = ['sparkle', 'layers', 'magnet']; t('feat').forEach((f, i) => { %>
      <div class="feat"><span class="feat__i"><%- include('partials/icon', { name: fi[i] }) %></span><div><h3><%= f[0] %></h3><p><%= f[1] %></p></div></div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/cau-tao') %>

<section class="sec">
  <div class="wrap">
    <div class="sec__head"><div><p class="eyebrow"><%= t('quickEyebrow') %></p><h2><%= t('quickTitle') %></h2><p class="lead"><%= t('quickSub') %></p></div><a class="link" href="<%= u('/bang-gia') %>"><%= t('viewAll') %></a></div>
    <div class="grid">
      <% quick.forEach((p, i) => { %><%- include('partials/card', { p, sub: t('cardSubs')[i] }) %><% }) %>
      <div class="card card--dash">
        <h3><%= t('otherQtyTitle') %></h3>
        <p><%= t('otherQtyBody') %></p>
        <a class="btn btn--ghost" href="<%= u('/bang-gia') %>"><%= t('openPrice') %></a>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--tint">
  <div class="wrap">
    <p class="eyebrow center"><%= t('stepsEyebrow') %></p>
    <h2 class="center"><%= t('stepsTitle') %></h2>
    <ol class="steps">
      <% t('steps').forEach((s, i) => { %><li><b><%= i + 1 %></b><h3><%= s[0] %></h3><p><%= s[1] %></p></li><% }) %>
    </ol>
    <p class="center mt-s"><a class="link" href="<%= u('/hoi-dap') %>"><%= t('faqLink') %></a></p>
  </div>
</section>

<% if (lang === 'vi') { %>
<section class="sec">
  <div class="wrap">
    <p class="eyebrow center"><%= t('occasionEyebrow') %></p>
    <h2 class="center"><%= t('occasionTitle') %></h2>
    <ul class="occ">
      <% landings.forEach(l => { %><li><a href="/<%= l.slug %>"><b><%= l.nav %></b><span><%= l.h1 %></span></a></li><% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="sec sec--tint">
  <div class="wrap">
    <p class="eyebrow center"><%= t('reviewsEyebrow') %></p>
    <h2 class="center"><%= t('reviewsTitle') %></h2>
    <%- include('partials/reviews', { list: reviews }) %>
    <p class="center mt-s">
      <% if (reviews.length && lang === 'vi') { %><a class="link" href="/danh-gia"><%= t('reviewsAll') %></a>
      <% } else { %><a class="btn btn--ghost" href="<%= site.tiktok %>" target="_blank" rel="noopener"><%= t('reviewsTiktok') %></a><% } %>
    </p>
  </div>
</section>

<% if (lang === 'vi' && latest.length) { %>
<section class="sec">
  <div class="wrap">
    <div class="sec__head"><div><p class="eyebrow"><%= t('blogEyebrow') %></p><h2><%= t('blogLatest') %></h2></div><a class="link" href="/blog"><%= t('viewAll') %></a></div>
    <div class="posts"><% latest.forEach(post => { %><%- include('partials/post-card', { post }) %><% }) %></div>
  </div>
</section>
<% } %>

<section class="sec">
  <div class="wrap cta">
    <div><h2><%= t('ctaTitle') %></h2><p><%= t('ctaBody') %></p></div>
    <a class="btn btn--zalo" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloCta') %></a>
  </div>
</section>
<%- include('partials/footer') %>