<%- include('partials/header') %>
<section class="sec">
  <div class="wrap">
    <p class="crumb"><a href="<%= u('/') %>"><%= t('crumbHome') %></a> / <a href="<%= u('/cua-hang') %>"><%= t('magnets') %></a> / <%= t('photos', p.qty) %></p>
    <div class="pd">
      <div class="pd__img"><img src="<%= productImg(p) %>" alt="<%= t('prodAlt', p) %>" width="600" height="600"></div>
      <div class="pd__info">
        <% if (p.hot) { %><span class="chip chip--static"><%= t('hot') %></span><% } %>
        <h1 class="h2"><%= t('comboOf', p.qty) %></h1>
        <p class="price price--lg"><%= money(p.price) %><% if (p.oldPrice > p.price) { %> <s><%= money(p.oldPrice) %></s><% } %></p>
        <p class="note"><%= t('approx', Math.round(p.price / p.qty / 1000), p.qty) %></p>
        <% if (p.freeship || p.gift) { %><p class="tags"><% if (p.gift) { %><span class="tag"><%- include('partials/icon', { name: 'gift' }) %><%= t('gift', p.gift) %></span><% } %><% if (p.freeship) { %><span class="tag"><%- include('partials/icon', { name: 'truck' }) %><%= t('freeship') %></span><% } %></p><% } %>
        <% const d = t('prodDesc')[p.qty]; %>
        <p class="lead"><%= d || t('prodBody') %></p>
        <% if (errors.length) { %><ul class="errors" role="alert"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul><% } %>
        <form method="post" action="<%= u('/gio-hang/them') %>" class="photo-step" id="dat-hang">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="id" value="<%= p.id %>">
          <fieldset>
            <legend><%= t('photoStep') %></legend>
            <label class="opt"><input type="radio" name="mode" value="link" data-photo-mode <%= form.mode !== 'zalo' ? 'checked' : '' %>> <%= t('photoModeLink') %></label>
            <label class="photo-link" data-photo-link>
              <span class="sr-only"><%= t('photoLinkLabel') %></span>
              <input type="url" name="photos" value="<%= form.photos %>" placeholder="<%= t('photoLinkPh') %>" inputmode="url" maxlength="500" <%= form.mode !== 'zalo' ? 'required' : '' %>>
              <small><%= t('photoHint') %></small>
            </label>
            <label class="opt"><input type="radio" name="mode" value="zalo" data-photo-mode <%= form.mode === 'zalo' ? 'checked' : '' %>> <%= t('photoModeZalo') %></label>
          </fieldset>
          <p class="photo-step__t"><%= t('buyStep') %></p>
          <div class="buy">
            <button class="btn" <%= p.stock < 1 ? 'disabled' : '' %>><%= p.stock < 1 ? t('soldOut') : t('addToCart') %></button>
            <button class="btn btn--ghost" name="next" value="checkout" <%= p.stock < 1 ? 'disabled' : '' %>><%= t('buyNow') %></button>
          </div>
        </form>
        <p class="note"><%= t('prodNote') %> <a class="link" href="<%= u('/hoi-dap') %>"><%= t('faqLink') %></a></p>
        <ul class="specs"><% t('specList', p).forEach(s => { %><li><%= s %></li><% }) %></ul>
        <a class="btn btn--zalo btn--sm" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloLong') %></a>
      </div>
    </div>
    <h2 class="h2 mt"><%= t('detailTitle') %></h2>
    <div class="feats">
      <% const di = ['printer', 'drop', 'hand']; t('detailFeat').forEach((f, i) => { %>
      <div class="feat"><span class="feat__i"><%- include('partials/icon', { name: di[i] }) %></span><div><h3><%= f[0] %></h3><p><%= f[1] %></p></div></div>
      <% }) %>
    </div>
    <% if (related.length) { %>
    <h2 class="h2 mt"><%= t('related') %></h2>
    <div class="grid"><% related.forEach(r => { %><%- include('partials/card', { p: r }) %><% }) %></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>