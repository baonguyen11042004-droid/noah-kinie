<%- include('partials/header') %>
<section class="sec">
  <div class="wrap">
    <p class="crumb"><a href="/">Trang chủ</a> / <a href="/cua-hang">Cửa hàng</a> / <%= p.name %></p>
    <div class="pd">
      <div class="pd__img"><img src="<%= productImg(p) %>" alt="<%= p.name %>" width="600" height="600"></div>
      <div class="pd__info">
        <% if (p.tag) { %><span class="chip chip--static"><%= p.tag %></span><% } %>
        <h1 class="h2"><%= p.name %></h1>
        <p class="price price--lg"><%= money(p.price) %><% if (p.oldPrice > p.price) { %> <s><%= money(p.oldPrice) %></s><% } %></p>
        <p class="lead"><%= p.short %></p>
        <form method="post" action="/gio-hang/them" class="buy">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="id" value="<%= p.id %>">
          <label>Số lượng <input type="number" name="qty" value="1" min="1" max="20"></label>
          <button class="btn" <%= p.stock < 1 ? 'disabled' : '' %>><%= p.stock < 1 ? 'Hết hàng' : 'Thêm vào giỏ' %></button>
          <button class="btn btn--ghost" name="next" value="checkout" <%= p.stock < 1 ? 'disabled' : '' %>>Mua ngay</button>
        </form>
        <p class="note">Sau khi đặt hàng, Kinie sẽ liên hệ để nhận ảnh của bạn qua Zalo/email.</p>
        <h3>Mô tả</h3>
        <p><%= p.description %></p>
        <% if (p.specs && p.specs.length) { %><ul class="specs"><% p.specs.forEach(s => { %><li><%= s %></li><% }) %></ul><% } %>
      </div>
    </div>
    <% if (related.length) { %>
    <h2 class="h2 mt">Có thể bạn thích</h2>
    <div class="grid"><% related.forEach(r => { %><%- include('partials/card', { p: r }) %><% }) %></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
