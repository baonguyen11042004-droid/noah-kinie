<section class="sec ct" aria-labelledby="ct-title">
  <div class="wrap ct__in">
    <div class="ct__chu">
      <p class="eyebrow"><%= t('layersEyebrow') %></p>
      <h2 id="ct-title"><%= t('layersTitle') %></h2>
      <p class="lead"><%= t('layersSub') %></p>
    </div>
    <div class="ct__scene" id="ct-scene" role="img" aria-label="<%= t('layersAlt') %>">
      <img class="ct__anh" id="ct-anh" src="/img/sp/tach-lop.jpg" alt="" width="688" height="1024" loading="lazy">
    </div>
    <div class="ct__ds">
      <ol class="ct__lop" id="ct-lop">
        <% t('layers').forEach((l, i) => { %><li data-lop="<%= i + 1 %>"><i><%= i + 1 %></i><div><b><%= l[0] %></b><span><%= l[1] %></span></div></li><% }) %>
      </ol>
      <div class="ct__ctl">
        <button class="btn btn--sm" id="ct-nut" type="button" data-mo="<%= t('layersOpen') %>" data-dong="<%= t('layersClose') %>"><%= t('layersOpen') %></button>
        <p class="note"><%= t('layersHint') %></p>
      </div>
    </div>
  </div>
</section>
<script type="module" src="/js/tach-lop.js?v=20261029"></script>
