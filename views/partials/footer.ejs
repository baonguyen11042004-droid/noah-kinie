</main>
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <a class="logo" href="/">Nhật ký Kinie<span>♥</span></a>
      <p><%= t('footTag') %></p>
      <img class="footer__logo" src="/img/logo.jpg" alt="Kinie Memory – Nhật ký Kinie" width="210" loading="lazy">
    </div>
    <div>
      <h4><%= t('footShop') %></h4>
      <a href="/bang-gia"><%= t('price') %></a>
      <% categories.forEach(c => { %><a href="/cua-hang?cat=<%= c.id %>"><%= t('tabs')[c.id] %></a><% }) %>
    </div>
    <div>
      <h4><%= t('footInfo') %></h4>
      <a href="/ve-kinie"><%= t('about') %></a>
      <a href="/lien-he"><%= t('contact') %></a>
      <a href="/gio-hang"><%= t('cart') %></a>
    </div>
    <div>
      <h4><%= t('footConnect') %></h4>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <% site.phones.forEach(ph => { %><span class="fphone"><a href="tel:<%= ph.tel %>"><%= ph.label %></a><a href="<%= ph.zalo %>" target="_blank" rel="noopener">Zalo</a></span><% }) %>
      <a href="<%= site.instagram %>" target="_blank" rel="noopener">Instagram</a>
      <a href="<%= site.facebook %>" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <p class="footer__c">© <%= new Date().getFullYear() %> Nhật ký Kinie. Made with ♥</p>
</footer>
<script src="/js/app.js" defer></script>
</body>
</html>