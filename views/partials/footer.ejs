</main>
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <a class="logo" href="/">Kinie<span>♥</span></a>
      <p>Biến những bức ảnh yêu thích thành nam châm xinh xắn – để kỷ niệm luôn ở ngay trên tủ lạnh.</p>
    </div>
    <div>
      <h4>Cửa hàng</h4>
      <% categories.forEach(c => { %><a href="/cua-hang?cat=<%= c.id %>"><%= c.name %></a><% }) %>
    </div>
    <div>
      <h4>Thông tin</h4>
      <a href="/ve-kinie">Về Kinie</a>
      <a href="/lien-he">Liên hệ</a>
      <a href="/gio-hang">Giỏ hàng</a>
    </div>
    <div>
      <h4>Kết nối</h4>
      <a href="mailto:<%= site.email %>"><%= site.email %></a>
      <a href="tel:<%= site.phone.replace(/\s/g,'') %>"><%= site.phone %></a>
      <a href="<%= site.zalo %>" target="_blank" rel="noopener">Zalo</a>
      <a href="<%= site.instagram %>" target="_blank" rel="noopener">Instagram</a>
      <a href="<%= site.facebook %>" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <p class="footer__c">© <%= new Date().getFullYear() %> Kinie. Made with ♥</p>
</footer>
<script src="/js/app.js" defer></script>
</body>
</html>
