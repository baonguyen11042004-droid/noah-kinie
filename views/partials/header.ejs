<!DOCTYPE html>
<html lang="<%= t('htmlLang') %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | Nhật ký Kinie' : 'Nhật ký Kinie – ' + t('homeTitle') %></title>
  <meta name="description" content="<%= desc %>">
  <meta property="og:title" content="<%= title || 'Nhật ký Kinie' %>">
  <meta property="og:description" content="<%= desc %>">
  <meta name="theme-color" content="#e8558a">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@400;600;700;900&family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=20260922">
  <script src="/js/theme.js"></script>
</head>
<body>
<a class="skip" href="#main"><%= t('skip') %></a>
<header class="nav">
  <div class="wrap nav__in">
    <a class="logo" href="/" aria-label="<%= t('homeAria') %>">Nhật ký Kinie<span>♥</span></a>
    <nav class="menu" id="menu" aria-label="<%= t('mainMenu') %>">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>"><%= t('home') %></a>
      <a href="/bang-gia" class="<%= path === '/bang-gia' ? 'on' : '' %>"><%= t('price') %></a>
      <a href="/cua-hang" class="<%= path.startsWith('/cua-hang') || path.startsWith('/san-pham') ? 'on' : '' %>"><%= t('magnets') %></a>
      <a href="/ve-kinie" class="<%= path === '/ve-kinie' ? 'on' : '' %>"><%= t('about') %></a>
      <a href="/lien-he" class="<%= path === '/lien-he' ? 'on' : '' %>"><%= t('contact') %></a>
    </nav>
    <div class="nav__r">
      <div class="lang" role="group" aria-label="<%= t('langLabel') %>">
        <% langs.forEach(l => { %><a href="/ngon-ngu/<%= l %>" class="<%= l === lang ? 'on' : '' %>" hreflang="<%= l %>" lang="<%= l %>" <%= l === lang ? 'aria-current=true' : '' %>><%= l.toUpperCase() %></a><% }) %>
      </div>
      <button class="theme" id="theme-toggle" type="button" data-to-dark="<%= t('darkTo') %>" data-to-light="<%= t('lightTo') %>" aria-label="<%= t('darkTo') %>" aria-pressed="false">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a class="btn btn--sm" href="/gio-hang" aria-label="<%= t('cartAria') %>"><span class="cart-txt"><%= t('cart') %></span> <b class="badge"><%= cartCount %></b></a>
      <button class="burger" id="burger" aria-label="<%= t('menuOpen') %>" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<main id="main">