<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | Kinie' : 'Kinie – Ảnh nam châm handmade' %></title>
  <meta name="description" content="<%= desc %>">
  <meta property="og:title" content="<%= title || 'Kinie' %>">
  <meta property="og:description" content="<%= desc %>">
  <meta name="theme-color" content="#f4a3a0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Nunito:wght@400;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<a class="skip" href="#main">Bỏ qua điều hướng</a>
<header class="nav">
  <div class="wrap nav__in">
    <a class="logo" href="/" aria-label="Kinie – trang chủ">Kinie<span>♥</span></a>
    <nav class="menu" id="menu" aria-label="Menu chính">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Trang chủ</a>
      <a href="/cua-hang" class="<%= path.startsWith('/cua-hang') || path.startsWith('/san-pham') ? 'on' : '' %>">Cửa hàng</a>
      <a href="/ve-kinie" class="<%= path === '/ve-kinie' ? 'on' : '' %>">Về Kinie</a>
      <a href="/lien-he" class="<%= path === '/lien-he' ? 'on' : '' %>">Liên hệ</a>
    </nav>
    <div class="nav__r">
      <button class="theme" id="theme-toggle" type="button" aria-label="Chuyển sang giao diện tối" aria-pressed="false">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a class="btn btn--sm" href="/gio-hang" aria-label="Giỏ hàng">Giỏ hàng <b class="badge"><%= cartCount %></b></a>
      <button class="burger" id="burger" aria-label="Mở menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<main id="main">
