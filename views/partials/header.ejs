<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? title + ' | Kinie' : 'Kinie – Ảnh nam châm handmade' %></title>
  <meta name="description" content="<%= desc %>">
  <meta property="og:title" content="<%= title || 'Kinie' %>">
  <meta property="og:description" content="<%= desc %>">
  <meta name="theme-color" content="#f4a3a0">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Nunito:wght@400;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip" href="#main">Bỏ qua điều hướng</a>
<header class="nav">
  <div class="wrap nav__in">
    <a class="logo" href="/" aria-label="Kinie – trang chủ">Kinie<span>♥</span></a>
    <nav class="menu" id="menu" aria-label="Menu chính">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Trang chủ</a>
      <a href="/cua-hang" class="<%= path.startsWith('/cua-hang') || path.startsWith('/san-pham') ? 'on' : '' %>">Cửa hàng</a>
      <a href="/ve-kinie" class="<%= path === '/ve-kinie' ? 'on' : '' %>">Về Kinie</a>
      <a href="/lien-he" class="<%= path === '/lien-he' ? 'on' : '' %>">Liên hệ</a>
    </nav>
    <div class="nav__r">
      <a class="btn btn--sm" href="/gio-hang" aria-label="Giỏ hàng">Giỏ hàng <b class="badge"><%= cartCount %></b></a>
      <button class="burger" id="burger" aria-label="Mở menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<main id="main">
