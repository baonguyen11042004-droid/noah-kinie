<article class="card">
  <a class="card__img" href="<%= u('/san-pham/' + p.slug) %>">
    <img src="<%= productImg(p) %>" alt="<%= t('prodAlt', p) %>" loading="lazy" width="400" height="400">
    <% if (p.hot) { %><span class="chip"><%= t('hot') %></span><% } %>
  </a>
  <div class="card__b">
    <h3><a href="<%= u('/san-pham/' + p.slug) %>"><%= t('photos', p.qty) %></a></h3>
    <% if (typeof sub !== 'undefined' && sub) { %><p class="card__sub"><%= sub %></p><% } %>
    <p class="price"><%= money(p.price) %><% if (p.oldPrice > p.price) { %> <s><%= money(p.oldPrice) %></s><% } %></p>
    <p class="card__per">≈ <%= Math.round(p.price / p.qty / 1000) %><%= t('perPhoto') %></p>
    <% if (p.freeship || p.gift) { %><p class="tags"><% if (p.gift) { %><span class="tag"><%- include('icon', { name: 'gift' }) %><%= t('gift', p.gift) %></span><% } %><% if (p.freeship) { %><span class="tag"><%- include('icon', { name: 'truck' }) %><%= t('freeship') %></span><% } %></p><% } %>
    <% if (p.stock < 1) { %><button class="btn btn--ghost btn--sm card__go" disabled><%= t('soldOut') %></button>
    <% } else { %><a class="btn btn--ghost btn--sm card__go" href="<%= u('/san-pham/' + p.slug) %>#dat-hang"><%= t('pickPhotos') %></a><% } %>
  </div>
</article>