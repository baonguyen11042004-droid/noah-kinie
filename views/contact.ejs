<%- include('partials/header') %>
<section class="sec">
  <div class="wrap narrow">
    <p class="eyebrow">Liên hệ</p>
    <h1 class="h2">Kể Kinie nghe ý tưởng của bạn</h1>
    <% if (sent) { %><p class="ok" role="status">Cảm ơn bạn! Kinie đã nhận tin nhắn và sẽ phản hồi sớm.</p><% } %>
    <% if (errors.length) { %><ul class="errors" role="alert"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul><% } %>
    <form method="post" action="/lien-he" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label>Tên<input name="name" value="<%= form.name || '' %>" required></label>
      <label>Email<input name="email" type="email" value="<%= form.email || '' %>" required></label>
      <label>Tin nhắn<textarea name="message" rows="5" required><%= form.message || '' %></textarea></label>
      <button class="btn">Gửi tin nhắn</button>
    </form>
    <p class="note">Hoặc nhắn nhanh: <a href="<%= site.zalo %>" target="_blank" rel="noopener">Zalo</a> · <a href="mailto:<%= site.email %>"><%= site.email %></a> · <%= site.phone %></p>
  </div>
</section>
<%- include('partials/footer') %>
