<%- include('partials/header') %>
<section class="sec">
  <div class="wrap about">
    <div>
      <p class="crumb"><a href="<%= u('/') %>"><%= t('crumbHome') %></a> / <%= t('about') %></p>
      <p class="eyebrow"><%= t('aboutEyebrow') %></p>
      <h1 class="h2"><%= t('aboutTitle') %></h1>
      <p class="lead"><%= t('aboutLead') %></p>
      <div class="hero__cta">
        <a class="btn" href="<%= u('/bang-gia') %>"><%= t('aboutCta') %></a>
        <a class="btn btn--zalo" href="<%= site.zalo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'chat' }) %><%= t('zaloCta') %></a>
      </div>
    </div>
    <div class="about__art"><img src="/img/sp/tu-lanh.webp" alt="<%= t('fridgeAlt') %>" width="900" height="1125"></div>
  </div>
  <div class="wrap narrow prose">
    <h2><%= t('aboutStoryTitle') %></h2>
    <p><%= t('aboutP1') %></p>

    <h2><%= t('aboutHandTitle') %></h2>
    <p><%= t('aboutP2') %></p>

    <h2><%= t('aboutProcessTitle') %></h2>
    <ol class="steps steps--list">
      <% t('aboutProcess').forEach((s, i) => { %><li><b><%= i + 1 %></b><h3><%= s[0] %></h3><p><%= s[1] %></p></li><% }) %>
    </ol>
  </div>
</section>

<%- include('partials/cau-tao') %>

<section class="sec sec--tiep">
  <div class="wrap narrow prose">
    <h2><%= t('aboutMaterialTitle') %></h2>
    <ul><% t('aboutList').forEach(s => { %><li><%= s %></li><% }) %><li><%= t('specs')[0][0] %>: <%= t('specs')[0][1] %> · <%= t('specs')[1][0] %>: <%= t('specs')[1][1] %></li></ul>

    <h2><%= t('aboutGiftTitle') %></h2>
    <p><%= t('aboutGiftBody') %></p>
    <% if (lang === 'vi') { %>
    <ul class="occ occ--sm">
      <% landings.forEach(l => { %><li><a href="/<%= l.slug %>"><b><%= l.nav %></b><span><%= l.h1 %></span></a></li><% }) %>
    </ul>
    <% } %>

    <h2><%= t('aboutWhyTitle') %></h2>
    <ul><% t('aboutWhy').forEach(s => { %><li><%= s %></li><% }) %></ul>
    <p><a class="link" href="<%= u('/hoi-dap') %>"><%= t('aboutMoreFaq') %></a></p>

    <div class="cta mt">
      <div><h2><%= t('ctaTitle') %></h2><p><%= t('ctaBody') %></p></div>
      <a class="btn" href="<%= u('/bang-gia') %>"><%= t('aboutCta') %></a>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
